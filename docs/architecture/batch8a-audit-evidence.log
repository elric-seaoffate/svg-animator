// SetBackground sets or replaces the authoritative background configuration.
func (s *Scene) SetBackground(bg *BackgroundConfig) {
	s.mu.Lock()
	defer s.mu.Unlock()

	if bg == nil {
		s.background = nil
		s.revision++
		return
	}

	b := *bg
	nw := b.NaturalWidth
	if nw <= 0 {
		nw = b.SourceWidth
	}
	if nw <= 0 {
		nw = 1280
	}
	nh := b.NaturalHeight
	if nh <= 0 {
		nh = b.SourceHeight
	}
	if nh <= 0 {
		nh = 720
	}
	b.NaturalWidth = nw
	b.NaturalHeight = nh
	if b.SourceWidth <= 0 {
		b.SourceWidth = nw
	}
	if b.SourceHeight <= 0 {
		b.SourceHeight = nh
	}

	if len(b.CropVersions) == 0 {
		b.CropVersions = []BackgroundCropVersion{
			{
				ID:           "original",
				Name:         "Original",
				SourceX:      0,
				SourceY:      0,
				SourceWidth:  nw,
				SourceHeight: nh,
			},
		}
		b.ActiveCropVersionID = "original"
	}
	if b.ActiveCropVersionID == "" {
		b.ActiveCropVersionID = "original"
	}

